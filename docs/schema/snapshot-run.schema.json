{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "Credibility": {
      "description": "The Admiralty credibility of one report's information, 1 (best) to 6 (cannot be judged).\n\nThe analyst judges credibility per report; the source's reliability is\nfixed by the watchlist. The two together make the grading, such as B2.",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Credibility",
      "type": "integer"
    },
    "CredibilityBar": {
      "additionalProperties": false,
      "description": "How many reports carry one credibility digit: one bar of the grade inflation check.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "credibility": {
          "$ref": "#/$defs/Credibility"
        },
        "label": {
          "description": "The Admiralty wording, such as probably true.",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "credibility",
        "label",
        "count"
      ],
      "title": "CredibilityBar",
      "type": "object"
    },
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "DisciplineCount": {
      "additionalProperties": false,
      "description": "One discipline's share of a run.",
      "properties": {
        "candidates": {
          "title": "Candidates",
          "type": "integer"
        },
        "discipline": {
          "$ref": "#/$defs/Discipline"
        },
        "sightings": {
          "title": "Sightings",
          "type": "integer"
        }
      },
      "required": [
        "discipline",
        "candidates",
        "sightings"
      ],
      "title": "DisciplineCount",
      "type": "object"
    },
    "DispositionCounts": {
      "additionalProperties": false,
      "description": "A run's candidates counted by their final disposition.",
      "properties": {
        "deferred": {
          "title": "Deferred",
          "type": "integer"
        },
        "duplicate": {
          "title": "Duplicate",
          "type": "integer"
        },
        "promoted": {
          "title": "Promoted",
          "type": "integer"
        },
        "reinforcement": {
          "title": "Reinforcement",
          "type": "integer"
        },
        "rejected": {
          "title": "Rejected",
          "type": "integer"
        }
      },
      "required": [
        "promoted",
        "rejected",
        "duplicate",
        "deferred",
        "reinforcement"
      ],
      "title": "DispositionCounts",
      "type": "object"
    },
    "DispositionView": {
      "additionalProperties": false,
      "description": "What the analyst did with one run's candidates.",
      "properties": {
        "counts": {
          "$ref": "#/$defs/DispositionCounts"
        },
        "disposed": {
          "title": "Disposed",
          "type": "integer"
        },
        "new": {
          "title": "New",
          "type": "integer"
        },
        "promotion_rate": {
          "anyOf": [
            {
              "description": "A share from 0 to 1, rounded to four places.",
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Promoted over new candidates.",
          "title": "Promotion Rate"
        },
        "undisposed": {
          "description": "New candidates nobody has judged yet.",
          "title": "Undisposed",
          "type": "integer"
        }
      },
      "required": [
        "counts",
        "new",
        "disposed",
        "undisposed",
        "promotion_rate"
      ],
      "title": "DispositionView",
      "type": "object"
    },
    "FunnelCounts": {
      "additionalProperties": false,
      "description": "How many hits survived each stage of the run.\n\nraw = dropped_own + dropped_negative + dropped_unrelated + passed, and\nunique = new + seen_before + reinforcements.",
      "properties": {
        "dropped_negative": {
          "minimum": 0,
          "title": "Dropped Negative",
          "type": "integer"
        },
        "dropped_own": {
          "minimum": 0,
          "title": "Dropped Own",
          "type": "integer"
        },
        "dropped_unrelated": {
          "minimum": 0,
          "title": "Dropped Unrelated",
          "type": "integer"
        },
        "new": {
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "passed": {
          "description": "Hits that passed every gate and reached deduplication.",
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "raw": {
          "minimum": 0,
          "title": "Raw",
          "type": "integer"
        },
        "reinforcements": {
          "minimum": 0,
          "title": "Reinforcements",
          "type": "integer"
        },
        "seen_before": {
          "minimum": 0,
          "title": "Seen Before",
          "type": "integer"
        },
        "unique": {
          "description": "Candidates: passed hits grouped by canonical URL.",
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        }
      },
      "required": [
        "raw",
        "dropped_own",
        "dropped_negative",
        "dropped_unrelated",
        "passed",
        "unique",
        "seen_before",
        "new",
        "reinforcements"
      ],
      "title": "FunnelCounts",
      "type": "object"
    },
    "RunStatus": {
      "description": "Where a scan run is in its life. A complete or aborted run never changes again.",
      "enum": [
        "running",
        "complete",
        "aborted"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceCount": {
      "additionalProperties": false,
      "description": "One source's share of a run: its sightings and the candidates it found first.",
      "properties": {
        "candidates": {
          "title": "Candidates",
          "type": "integer"
        },
        "sightings": {
          "title": "Sightings",
          "type": "integer"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for the open web.",
          "title": "Source Id"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Name"
        }
      },
      "required": [
        "source_id",
        "source_name",
        "sightings",
        "candidates"
      ],
      "title": "SourceCount",
      "type": "object"
    }
  },
  "$id": "snapshot-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "runs/<id>.json, GET /api/v1/scan-runs/{id}: one run in full.",
  "properties": {
    "budget_exhausted": {
      "title": "Budget Exhausted",
      "type": "boolean"
    },
    "candidates": {
      "title": "Candidates",
      "type": "integer"
    },
    "credibility": {
      "description": "The reports this run created.",
      "items": {
        "$ref": "#/$defs/CredibilityBar"
      },
      "title": "Credibility",
      "type": "array"
    },
    "disciplines": {
      "items": {
        "$ref": "#/$defs/Discipline"
      },
      "title": "Disciplines",
      "type": "array"
    },
    "dispositions": {
      "$ref": "#/$defs/DispositionView"
    },
    "finished_at": {
      "anyOf": [
        {
          "description": "ISO 8601, UTC.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "funnel": {
      "$ref": "#/$defs/FunnelCounts"
    },
    "instrument_hash": {
      "title": "Instrument Hash",
      "type": "string"
    },
    "instrument_version": {
      "title": "Instrument Version",
      "type": "string"
    },
    "notes": {
      "description": "What the run says about itself, such as the budget.",
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "per_discipline": {
      "items": {
        "$ref": "#/$defs/DisciplineCount"
      },
      "title": "Per Discipline",
      "type": "array"
    },
    "per_source": {
      "items": {
        "$ref": "#/$defs/SourceCount"
      },
      "title": "Per Source",
      "type": "array"
    },
    "promoted": {
      "title": "Promoted",
      "type": "integer"
    },
    "promoted_report_ids": {
      "items": {
        "type": "string"
      },
      "title": "Promoted Report Ids",
      "type": "array"
    },
    "reinforcements_recorded": {
      "description": "Reinforcements spotted at collection.",
      "title": "Reinforcements Recorded",
      "type": "integer"
    },
    "request_budget": {
      "title": "Request Budget",
      "type": "integer"
    },
    "requests_made": {
      "title": "Requests Made",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "description": "ISO 8601, UTC.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "submissions": {
      "items": {
        "type": "string"
      },
      "title": "Submissions",
      "type": "array"
    },
    "undisposed": {
      "title": "Undisposed",
      "type": "integer"
    },
    "warnings": {
      "description": "The collectors' warnings, from the candidates file.",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "status",
    "instrument_version",
    "instrument_hash",
    "disciplines",
    "funnel",
    "requests_made",
    "request_budget",
    "budget_exhausted",
    "candidates",
    "promoted",
    "undisposed",
    "submissions",
    "reinforcements_recorded",
    "notes",
    "warnings",
    "per_source",
    "per_discipline",
    "dispositions",
    "credibility",
    "promoted_report_ids"
  ],
  "title": "RunDetail",
  "type": "object"
}
