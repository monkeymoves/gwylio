{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "FunnelCounts": {
      "additionalProperties": false,
      "description": "How many hits survived each stage of the run.\n\nraw = dropped_own + dropped_negative + dropped_unrelated + passed, and\nunique = new + seen_before + reinforcements.",
      "properties": {
        "dropped_negative": {
          "minimum": 0,
          "title": "Dropped Negative",
          "type": "integer"
        },
        "dropped_own": {
          "minimum": 0,
          "title": "Dropped Own",
          "type": "integer"
        },
        "dropped_unrelated": {
          "minimum": 0,
          "title": "Dropped Unrelated",
          "type": "integer"
        },
        "new": {
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "passed": {
          "description": "Hits that passed every gate and reached deduplication.",
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "raw": {
          "minimum": 0,
          "title": "Raw",
          "type": "integer"
        },
        "reinforcements": {
          "minimum": 0,
          "title": "Reinforcements",
          "type": "integer"
        },
        "seen_before": {
          "minimum": 0,
          "title": "Seen Before",
          "type": "integer"
        },
        "unique": {
          "description": "Candidates: passed hits grouped by canonical URL.",
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        }
      },
      "required": [
        "raw",
        "dropped_own",
        "dropped_negative",
        "dropped_unrelated",
        "passed",
        "unique",
        "seen_before",
        "new",
        "reinforcements"
      ],
      "title": "FunnelCounts",
      "type": "object"
    },
    "RunStatus": {
      "description": "Where a scan run is in its life. A complete or aborted run never changes again.",
      "enum": [
        "running",
        "complete",
        "aborted"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "snapshot-run-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entry of runs.json, GET /api/v1/scan-runs. Runs are listed oldest first.",
  "properties": {
    "budget_exhausted": {
      "title": "Budget Exhausted",
      "type": "boolean"
    },
    "candidates": {
      "title": "Candidates",
      "type": "integer"
    },
    "disciplines": {
      "items": {
        "$ref": "#/$defs/Discipline"
      },
      "title": "Disciplines",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "description": "ISO 8601, UTC.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "funnel": {
      "$ref": "#/$defs/FunnelCounts"
    },
    "instrument_version": {
      "title": "Instrument Version",
      "type": "string"
    },
    "promoted": {
      "title": "Promoted",
      "type": "integer"
    },
    "request_budget": {
      "title": "Request Budget",
      "type": "integer"
    },
    "requests_made": {
      "title": "Requests Made",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "description": "ISO 8601, UTC.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "submissions": {
      "description": "Ids of the submissions that judged this run.",
      "items": {
        "type": "string"
      },
      "title": "Submissions",
      "type": "array"
    },
    "undisposed": {
      "title": "Undisposed",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "status",
    "instrument_version",
    "disciplines",
    "funnel",
    "requests_made",
    "request_budget",
    "budget_exhausted",
    "candidates",
    "promoted",
    "undisposed",
    "submissions"
  ],
  "title": "RunSummary",
  "type": "object"
}
