    },
    "runs_total": {
      "title": "Runs Total",
      "type": "integer"
    },
    "silent_sources": {
      "description": "Active sources with no hit in any run.",
      "items": {
        "type": "string"
      },
      "title": "Silent Sources",
      "type": "array"
    },
    "sources": {
      "title": "Sources",
      "type": "integer"
    },
    "trend": {
