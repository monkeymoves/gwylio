{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "FunnelCounts": {
      "additionalProperties": false,
      "description": "How many hits survived each stage of the run.\n\nraw = dropped_own + dropped_negative + dropped_unrelated + passed, and\nunique = new + seen_before + reinforcements.",
      "properties": {
        "dropped_negative": {
          "minimum": 0,
          "title": "Dropped Negative",
          "type": "integer"
        },
        "dropped_own": {
          "minimum": 0,
          "title": "Dropped Own",
          "type": "integer"
        },
        "dropped_unrelated": {
          "minimum": 0,
          "title": "Dropped Unrelated",
          "type": "integer"
        },
        "new": {
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "passed": {
          "description": "Hits that passed every gate and reached deduplication.",
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "raw": {
          "minimum": 0,
          "title": "Raw",
          "type": "integer"
        },
        "reinforcements": {
          "minimum": 0,
          "title": "Reinforcements",
          "type": "integer"
        },
        "seen_before": {
          "minimum": 0,
          "title": "Seen Before",
          "type": "integer"
        },
        "unique": {
          "description": "Candidates: passed hits grouped by canonical URL.",
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        }
      },
      "required": [
        "raw",
        "dropped_own",
        "dropped_negative",
        "dropped_unrelated",
        "passed",
        "unique",
        "seen_before",
        "new",
        "reinforcements"
      ],
      "title": "FunnelCounts",
      "type": "object"
    },
    "FunnelPoint": {
      "additionalProperties": false,
      "description": "One run's funnel on the trend.",
      "properties": {
        "budget_exhausted": {
          "title": "Budget Exhausted",
          "type": "boolean"
        },
        "funnel": {
          "$ref": "#/$defs/FunnelCounts"
        },
        "request_budget": {
          "title": "Request Budget",
          "type": "integer"
        },
        "requests_made": {
          "title": "Requests Made",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "description": "ISO 8601, UTC.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "funnel",
        "requests_made",
        "request_budget",
        "budget_exhausted"
      ],
      "title": "FunnelPoint",
      "type": "object"
    },
    "ReadingCounts": {
      "additionalProperties": false,
      "description": "Sources counted by yield reading.",
      "properties": {
        "earning_its_place": {
          "title": "Earning Its Place",
          "type": "integer"
        },
        "high_volume_no_promotions": {
          "title": "High Volume No Promotions",
          "type": "integer"
        },
        "low_volume": {
          "title": "Low Volume",
          "type": "integer"
        },
        "silent": {
          "title": "Silent",
          "type": "integer"
        }
      },
      "required": [
        "earning_its_place",
        "high_volume_no_promotions",
        "low_volume",
        "silent"
      ],
      "title": "ReadingCounts",
      "type": "object"
    }
  },
  "$id": "snapshot-sources-health.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "sources_health.json, GET /api/v1/sources/health: the funnel trend and silent sources.",
  "properties": {
    "active_sources": {
      "title": "Active Sources",
      "type": "integer"
    },
    "readings": {
