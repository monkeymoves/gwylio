          "title": "Requirement Id",
          "type": "string"
        },
        "set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Set Id"
        }
      },
      "required": [
        "requirement_id",
        "code",
        "name",
        "set_id",
        "direction"
      ],
      "title": "AssessmentDetail",
      "type": "object"
    },
    "Bucket": {
      "description": "Where a report goes next.",
      "enum": [
        "brief",
        "follow_up",
        "watch",
        "park"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Credibility": {
      "description": "The Admiralty credibility of one report's information, 1 (best) to 6 (cannot be judged).\n\nThe analyst judges credibility per report; the source's reliability is\nfixed by the watchlist. The two together make the grading, such as B2.",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Credibility",
      "type": "integer"
    },
    "Direction": {
      "description": "Which way a report bears on one requirement.",
      "enum": [
        "supports",
        "threatens",
        "neutral",
        "informs_baseline"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "FindingKind": {
      "description": "What the date check found wrong with a report.",
      "enum": [
        "passed_horizon",
        "future_language",
        "stale_verification",
        "never_verified"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingLine": {
