{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "CoverageStatus": {
      "description": "The state of one requirement in the picture.",
      "enum": [
        "covered",
        "thin",
        "quiet",
        "blind_spot"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "DateCheckCounts": {
      "additionalProperties": false,
      "description": "Date check findings counted by kind, their total, and the reports they flag.",
      "properties": {
        "future_language": {
          "title": "Future Language",
          "type": "integer"
        },
        "never_verified": {
          "title": "Never Verified",
          "type": "integer"
        },
        "passed_horizon": {
          "title": "Passed Horizon",
          "type": "integer"
        },
        "reports_flagged": {
          "title": "Reports Flagged",
          "type": "integer"
        },
        "stale_verification": {
          "title": "Stale Verification",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "passed_horizon",
        "future_language",
        "stale_verification",
        "never_verified",
        "total",
        "reports_flagged"
      ],
      "title": "DateCheckCounts",
      "type": "object"
    },
    "DirectionCounts": {
      "additionalProperties": false,
      "description": "Reports counted by the direction of their assessment.",
      "properties": {
        "informs_baseline": {
          "title": "Informs Baseline",
          "type": "integer"
        },
        "neutral": {
          "title": "Neutral",
          "type": "integer"
        },
        "supports": {
          "title": "Supports",
          "type": "integer"
        },
        "threatens": {
          "title": "Threatens",
          "type": "integer"
        }
      },
      "required": [
        "supports",
        "threatens",
        "neutral",
        "informs_baseline"
      ],
      "title": "DirectionCounts",
      "type": "object"
    },
    "GroupKind": {
      "description": "What a requirement group stands for.",
      "enum": [
        "impact",
        "wbo"
      ],
      "title": "GroupKind",
      "type": "string"
    },
    "GroupTile": {
      "additionalProperties": false,
      "description": "One group on the picture, aggregated over its member requirements.\n\n``active`` and ``total`` count distinct reports; ``directions`` counts\ndistinct active reports with at least one assessment in that direction on\na member, so a report that cuts two ways counts under both.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "integer"
        },
        "directions": {
          "$ref": "#/$defs/DirectionCounts"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "latest_event_horizon": {
          "anyOf": [
            {
              "description": "YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Event Horizon"
        },
        "latest_verified": {
          "anyOf": [
            {
              "description": "YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Verified"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statement"
        },
        "states": {
          "$ref": "#/$defs/StateCounts"
        },
        "statuses": {
          "$ref": "#/$defs/StatusCounts",
          "description": "Member requirements by coverage status."
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "kind",
        "name",
        "statement",
        "members",
        "active",
        "total",
        "directions",
        "states",
        "statuses",
        "latest_event_horizon",
        "latest_verified"
      ],
      "title": "GroupTile",
      "type": "object"
    },
    "RequirementTile": {
      "additionalProperties": false,
      "description": "One requirement on the picture: its reports by direction and state, and its status.\n\n``active`` counts the active reports (emerging, tracking, reinforced)\nassessed on it, and ``directions`` splits them by the direction of that\nassessment, so the directions add up to ``active``. ``states`` counts\nevery report assessed on it. The latest dates come from reports still in\nthe picture (active or matured).",
      "properties": {
        "active": {
          "title": "Active",
          "type": "integer"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "directions": {
          "$ref": "#/$defs/DirectionCounts"
        },
        "group_ids": {
          "items": {
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "latest_event_horizon": {
          "anyOf": [
            {
              "description": "YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Event Horizon"
        },
        "latest_verified": {
          "anyOf": [
            {
              "description": "YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Verified"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "scanability": {
          "$ref": "#/$defs/Scanability"
        },
        "short": {
          "title": "Short",
          "type": "string"
        },
        "states": {
          "$ref": "#/$defs/StateCounts"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "requirement_id",
        "code",
        "short",
        "name",
        "scanability",
        "status",
        "active",
        "total",
        "directions",
        "states",
        "latest_event_horizon",
        "latest_verified",
        "group_ids"
      ],
      "title": "RequirementTile",
      "type": "object"
    },
    "Scanability": {
      "description": "How far public, indexed sources can see a requirement at all.",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "title": "Scanability",
      "type": "string"
    },
    "StateCounts": {
      "additionalProperties": false,
      "description": "Reports counted by indicator state.",
      "properties": {
        "emerging": {
          "title": "Emerging",
          "type": "integer"
        },
        "faded": {
          "title": "Faded",
          "type": "integer"
        },
        "matured": {
          "title": "Matured",
          "type": "integer"
        },
        "parked": {
          "title": "Parked",
          "type": "integer"
        },
        "reinforced": {
          "title": "Reinforced",
          "type": "integer"
        },
        "tracking": {
          "title": "Tracking",
          "type": "integer"
        }
      },
      "required": [
        "emerging",
        "tracking",
        "reinforced",
        "matured",
        "faded",
        "parked"
      ],
      "title": "StateCounts",
      "type": "object"
    },
    "StatusCounts": {
      "additionalProperties": false,
      "description": "Requirements counted by coverage status.",
      "properties": {
        "blind_spot": {
          "title": "Blind Spot",
          "type": "integer"
        },
        "covered": {
          "title": "Covered",
          "type": "integer"
        },
        "quiet": {
          "title": "Quiet",
          "type": "integer"
        },
        "thin": {
          "title": "Thin",
          "type": "integer"
        }
      },
      "required": [
        "covered",
        "thin",
        "quiet",
        "blind_spot"
      ],
      "title": "StatusCounts",
      "type": "object"
    }
  },
  "$id": "snapshot-picture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "picture_<set>.json, GET /api/v1/requirement-sets/{id}/picture.",
  "properties": {
    "datecheck": {
      "$ref": "#/$defs/DateCheckCounts"
    },
    "impact_groups": {
      "items": {
        "$ref": "#/$defs/GroupTile"
      },
      "title": "Impact Groups",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementTile"
      },
      "title": "Requirements",
      "type": "array"
    },
    "set_id": {
      "title": "Set Id",
      "type": "string"
    },
    "set_name": {
      "title": "Set Name",
      "type": "string"
    },
    "today": {
      "description": "YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Today",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "wbo_groups": {
      "items": {
        "$ref": "#/$defs/GroupTile"
      },
      "title": "Wbo Groups",
      "type": "array"
    }
  },
  "required": [
    "set_id",
    "set_name",
    "version",
    "today",
    "wbo_groups",
    "impact_groups",
    "requirements",
    "datecheck"
  ],
  "title": "Picture",
  "type": "object"
}
