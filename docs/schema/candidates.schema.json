{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "CandidateEntry": {
      "additionalProperties": false,
      "description": "One candidate: a gated, deduplicated hit, one per canonical URL in the run.",
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_url": {
          "description": "The canonical URL: no scheme, www, fragment or tracking.",
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "discipline": {
          "$ref": "#/$defs/Discipline"
        },
        "first_seen_run_id": {
          "description": "The run that first recorded this URL.",
          "pattern": "^[0-9]{8}T[0-9]{4}Z-[0-9a-f]{4}$",
          "title": "First Seen Run Id",
          "type": "string"
        },
        "lane": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Lane",
          "type": "string"
        },
        "published_on": {
          "anyOf": [
            {
              "description": "A date, YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published On"
        },
        "query_id": {
          "description": "The query whose hit found this URL first.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Query Id",
          "type": "string"
        },
        "requirement_hints": {
          "description": "Hints from the queries; not tags.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Requirement Hints",
          "type": "array"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The watched source, or null for the open web.",
          "title": "Source Id"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "topic_hints": {
          "description": "Hints from the queries; not tags.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Topic Hints",
          "type": "array"
        },
        "trusted": {
          "title": "Trusted",
          "type": "boolean"
        },
        "url": {
          "description": "The URL as first found, before canonicalising.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "status",
        "url",
        "canonical_url",
        "title",
        "snippet",
        "published_on",
        "first_seen_run_id",
        "source_id",
        "lane",
        "discipline",
        "query_id",
        "requirement_hints",
        "topic_hints",
        "trusted"
      ],
      "title": "CandidateEntry",
      "type": "object"
    },
    "CandidateStatus": {
      "description": "What the collector knew about a candidate's canonical URL when it found it.",
      "enum": [
        "new",
        "seen_before",
        "reinforcement"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "FunnelCounts": {
      "additionalProperties": false,
      "description": "How many hits survived each stage of the run.\n\nraw = dropped_own + dropped_negative + dropped_unrelated + passed, and\nunique = new + seen_before + reinforcements.",
      "properties": {
        "dropped_negative": {
          "minimum": 0,
          "title": "Dropped Negative",
          "type": "integer"
        },
        "dropped_own": {
          "minimum": 0,
          "title": "Dropped Own",
          "type": "integer"
        },
        "dropped_unrelated": {
          "minimum": 0,
          "title": "Dropped Unrelated",
          "type": "integer"
        },
        "new": {
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "passed": {
          "description": "Hits that passed every gate and reached deduplication.",
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "raw": {
          "minimum": 0,
          "title": "Raw",
          "type": "integer"
        },
        "reinforcements": {
          "minimum": 0,
          "title": "Reinforcements",
          "type": "integer"
        },
        "seen_before": {
          "minimum": 0,
          "title": "Seen Before",
          "type": "integer"
        },
        "unique": {
          "description": "Candidates: passed hits grouped by canonical URL.",
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        }
      },
      "required": [
        "raw",
        "dropped_own",
        "dropped_negative",
        "dropped_unrelated",
        "passed",
        "unique",
        "seen_before",
        "new",
        "reinforcements"
      ],
      "title": "FunnelCounts",
      "type": "object"
    },
    "MatchedBy": {
      "description": "How a candidate was matched to an existing intelligence report.",
      "enum": [
        "url",
        "title"
      ],
      "title": "MatchedBy",
      "type": "string"
    },
    "ReinforcementEntry": {
      "additionalProperties": false,
      "description": "A candidate that matched an existing intelligence report at collection time.",
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "matched_by": {
          "$ref": "#/$defs/MatchedBy"
        },
        "report_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "report_id",
        "matched_by"
      ],
      "title": "ReinforcementEntry",
      "type": "object"
    },
    "SightingEntry": {
      "additionalProperties": false,
      "description": "One hit that became part of a candidate.",
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "discipline": {
          "$ref": "#/$defs/Discipline"
        },
        "query_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Query Id",
          "type": "string"
        },
        "sighting_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Sighting Id",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        }
      },
      "required": [
        "sighting_id",
        "candidate_id",
        "source_id",
        "query_id",
        "discipline"
      ],
      "title": "SightingEntry",
      "type": "object"
    }
  },
  "$id": "candidates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "data/candidates/<run_id>.json: everything one completed scan run found.",
  "properties": {
    "budget_exhausted": {
      "title": "Budget Exhausted",
      "type": "boolean"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateEntry"
      },
      "title": "Candidates",
      "type": "array"
    },
    "disciplines_run": {
      "items": {
        "$ref": "#/$defs/Discipline"
      },
      "title": "Disciplines Run",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "format": {
      "const": "gwylio.candidates/1",
      "description": "Always gwylio.candidates/1.",
      "title": "Format",
      "type": "string"
    },
    "funnel": {
      "$ref": "#/$defs/FunnelCounts"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "instrument_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Instrument Hash",
      "type": "string"
    },
    "instrument_version": {
      "title": "Instrument Version",
      "type": "string"
    },
    "max_requests_per_run": {
      "minimum": 1,
      "title": "Max Requests Per Run",
      "type": "integer"
    },
    "notes": {
      "description": "What the run says about itself, such as the budget.",
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "reinforcements": {
      "items": {
        "$ref": "#/$defs/ReinforcementEntry"
      },
      "title": "Reinforcements",
      "type": "array"
    },
    "requests_made": {
      "minimum": 0,
      "title": "Requests Made",
      "type": "integer"
    },
    "run_id": {
      "description": "A scan run id.",
      "pattern": "^[0-9]{8}T[0-9]{4}Z-[0-9a-f]{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "sightings": {
      "items": {
        "$ref": "#/$defs/SightingEntry"
      },
      "title": "Sightings",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "warnings": {
      "description": "Soft failures the collectors reported.",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "format",
    "run_id",
    "instrument_version",
    "instrument_hash",
    "generated_at",
    "started_at",
    "finished_at",
    "disciplines_run",
    "max_requests_per_run",
    "requests_made",
    "budget_exhausted",
    "funnel",
    "notes",
    "warnings",
    "candidates",
    "reinforcements",
    "sightings"
  ],
  "title": "CandidatesFile",
  "type": "object"
}
