{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "Reliability": {
      "description": "The Admiralty reliability of a source, A (best) to F (cannot be judged).\n\nReliability belongs to the source, never to one report: the analyst judges\ncredibility (1 to 6) per report, and the two together make the grading.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ],
      "title": "Reliability",
      "type": "string"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "description": "A watchlist entry: where hits come from, with a default reliability.",
      "properties": {
        "actor": {
          "description": "The actor that publishes on this source.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Actor",
          "type": "string"
        },
        "added_on": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Added On",
          "type": "string"
        },
        "discipline": {
          "$ref": "#/$defs/Discipline"
        },
        "domain": {
          "description": "Bare host; hits are matched to sources by exact domain.",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
          "title": "Domain",
          "type": "string"
        },
        "feed_url": {
          "anyOf": [
            {
              "pattern": "^https?://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for osint_feed sources.",
          "title": "Feed Url"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "lane": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Lane",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "reliability": {
          "$ref": "#/$defs/Reliability",
          "description": "Admiralty reliability, A to F."
        },
        "site_pass": {
          "description": "Whether site queries may sweep this source's domain.",
          "title": "Site Pass",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/SourceStatus",
          "default": "active"
        },
        "trusted": {
          "description": "A trusted source passes the relevance gate on domain alone.",
          "title": "Trusted",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "discipline",
        "lane",
        "actor",
        "reliability",
        "trusted",
        "site_pass",
        "added_on"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "SourceStatus": {
      "description": "Whether a source is watched.",
      "enum": [
        "active",
        "parked",
        "retired"
      ],
      "title": "SourceStatus",
      "type": "string"
    }
  },
  "$id": "sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "config/sources.json: the source watchlist.",
  "properties": {
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources"
  ],
  "title": "SourcesFile",
  "type": "object"
}
