{
  "$comment": "Generated by `gwylio schema` from the Pydantic models in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "ActorConfig": {
      "additionalProperties": false,
      "description": "An organisation that publishes or is reported on.",
      "properties": {
        "domain": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bare host, such as gov.wales.",
          "title": "Domain"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "lane": {
          "description": "The lane where this actor is usually found.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Lane",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "lane"
      ],
      "title": "ActorConfig",
      "type": "object"
    },
    "ActorKind": {
      "description": "The kind of an organisation.",
      "enum": [
        "government",
        "legislature",
        "regulator",
        "public_body",
        "research",
        "ngo",
        "business",
        "union",
        "media",
        "international",
        "other"
      ],
      "title": "ActorKind",
      "type": "string"
    }
  },
  "$id": "actors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "config/reference/actors.json: the actor catalogue.",
  "properties": {
    "actors": {
      "items": {
        "$ref": "#/$defs/ActorConfig"
      },
      "minItems": 1,
      "title": "Actors",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "actors"
  ],
  "title": "ActorsFile",
  "type": "object"
}
