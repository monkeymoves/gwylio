{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "PeriodModel": {
      "additionalProperties": false,
      "description": "The dates a product covers, inclusive, and its label.",
      "properties": {
        "end": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "End",
          "type": "string"
        },
        "label": {
          "description": "YYYY-MM for a month, YYYY for a year.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Label",
          "type": "string"
        },
        "start": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "label"
      ],
      "title": "PeriodModel",
      "type": "object"
    },
    "ProductLevel": {
      "description": "The level a product serves: the annual picture, the monthly summary, or an alert.",
      "enum": [
        "strategic",
        "operational",
        "tactical"
      ],
      "title": "ProductLevel",
      "type": "string"
    },
    "SectionModel": {
      "additionalProperties": false,
      "description": "One section: heading, paragraphs, tables and bullets, rendered in that order.",
      "properties": {
        "body": {
          "items": {
            "type": "string"
          },
          "title": "Body",
          "type": "array"
        },
        "bullets": {
          "items": {
            "type": "string"
          },
          "title": "Bullets",
          "type": "array"
        },
        "depth": {
          "description": "2 for a section, 3 for a subsection.",
          "maximum": 3,
          "minimum": 2,
          "title": "Depth",
          "type": "integer"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/TableModel"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "depth",
        "body",
        "tables",
        "bullets"
      ],
      "title": "SectionModel",
      "type": "object"
    },
    "TableModel": {
      "additionalProperties": false,
      "description": "A table: header cells, then rows of cells as wide as the header.",
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Headers",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "headers",
        "rows"
      ],
      "title": "TableModel",
      "type": "object"
    }
  },
  "$id": "product.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "data/products/<stem>.json: one rendered product's structure.",
  "properties": {
    "format": {
      "const": "gwylio.product/1",
      "description": "Always gwylio.product/1.",
      "title": "Format",
      "type": "string"
    },
    "generated_on": {
      "description": "A date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Generated On",
      "type": "string"
    },
    "id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "lead": {
      "items": {
        "type": "string"
      },
      "title": "Lead",
      "type": "array"
    },
    "level": {
      "$ref": "#/$defs/ProductLevel"
    },
    "markdown_file": {
      "description": "The Markdown file beside this one.",
      "pattern": "^[a-z0-9_-]+\\.md$",
      "title": "Markdown File",
      "type": "string"
    },
    "method_note": {
      "title": "Method Note",
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/PeriodModel"
    },
    "report_ids": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Report Ids",
      "type": "array"
    },
    "requirement_set_id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Requirement Set Id",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionModel"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "format",
    "id",
    "level",
    "requirement_set_id",
    "period",
    "generated_on",
    "title",
    "lead",
    "sections",
    "report_ids",
    "method_note",
    "markdown_file"
  ],
  "title": "ProductFile",
  "type": "object"
}
