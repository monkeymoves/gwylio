  "$id": "snapshot-meta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "meta.json, GET /api/v1/meta: when and from what the snapshot was built.",
  "properties": {
    "app_version": {
      "title": "App Version",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/MetaCounts"
    },
    "default_requirement_set_id": {
      "title": "Default Requirement Set Id",
      "type": "string"
    },
    "generated_at": {
      "description": "When the snapshot or response was built.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
      "title": "Generated At",
      "type": "string"
    },
    "instrument_version": {
      "description": "The current instrument in config/.",
      "title": "Instrument Version",
      "type": "string"
    },
    "latest_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latest Run Id"
    },
    "latest_run_started_at": {
      "anyOf": [
        {
          "description": "ISO 8601, UTC.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latest Run Started At"
    },
    "requirement_set_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requirement Set Ids",
      "type": "array"
    },
    "rubric_version": {
      "title": "Rubric Version",
      "type": "string"
    },
    "today": {
      "description": "The date the date check and the picture were computed for.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Today",
      "type": "string"
    }
  },
  "required": [
    "generated_at",
    "today",
    "app_version",
    "rubric_version",
    "instrument_version",
    "latest_run_id",
    "latest_run_started_at",
    "default_requirement_set_id",
    "requirement_set_ids",
