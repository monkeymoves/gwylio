{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "AssessmentLine": {
      "additionalProperties": false,
      "description": "One assessment on a report list line.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The requirement's code, null when no set holds it.",
          "title": "Code"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Set Id"
        }
      },
      "required": [
        "requirement_id",
        "code",
        "set_id",
        "direction"
      ],
      "title": "AssessmentLine",
      "type": "object"
    },
    "Bucket": {
      "description": "Where a report goes next.",
      "enum": [
        "brief",
        "follow_up",
        "watch",
        "park"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Credibility": {
      "description": "The Admiralty credibility of one report's information, 1 (best) to 6 (cannot be judged).\n\nThe analyst judges credibility per report; the source's reliability is\nfixed by the watchlist. The two together make the grading, such as B2.",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Credibility",
      "type": "integer"
    },
    "Direction": {
      "description": "Which way a report bears on one requirement.",
      "enum": [
        "supports",
        "threatens",
        "neutral",
        "informs_baseline"
      ],
      "title": "Direction",
      "type": "string"
    },
    "FindingKind": {
      "description": "What the date check found wrong with a report.",
      "enum": [
        "passed_horizon",
        "future_language",
        "stale_verification",
        "never_verified"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "IndicatorState": {
      "description": "Where a report is in the indications and warnings lifecycle.",
      "enum": [
        "emerging",
        "tracking",
        "reinforced",
        "matured",
        "faded",
        "parked"
      ],
      "title": "IndicatorState",
      "type": "string"
    },
    "Reliability": {
      "description": "The Admiralty reliability of a source, A (best) to F (cannot be judged).\n\nReliability belongs to the source, never to one report: the analyst judges\ncredibility (1 to 6) per report, and the two together make the grading.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ],
      "title": "Reliability",
      "type": "string"
    },
    "ReportType": {
      "description": "What kind of development an intelligence report describes.",
      "enum": [
        "policy",
        "legislation",
        "research",
        "data_release",
        "funding",
        "partnership",
        "international",
        "legal",
        "environmental",
        "market",
        "incident"
      ],
      "title": "ReportType",
      "type": "string"
    }
  },
  "$id": "snapshot-report-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entry of reports.json, GET /api/v1/reports: what the list and its filters need.",
  "properties": {
    "appearances": {
      "description": "Distinct runs with a sighting of the report.",
      "title": "Appearances",
      "type": "integer"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/AssessmentLine"
      },
      "title": "Assessments",
      "type": "array"
    },
    "bucket": {
      "$ref": "#/$defs/Bucket"
    },
    "created_on": {
      "description": "YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Created On",
      "type": "string"
    },
    "credibility": {
      "$ref": "#/$defs/Credibility"
    },
    "directions": {
      "description": "Distinct directions, in vocabulary order.",
      "items": {
        "$ref": "#/$defs/Direction"
      },
      "title": "Directions",
      "type": "array"
    },
    "distinct_sources": {
      "description": "Distinct watched sources that sighted it.",
      "title": "Distinct Sources",
      "type": "integer"
    },
    "event_horizon": {
      "anyOf": [
        {
          "description": "YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Event Horizon"
    },
    "flags": {
      "description": "The date check's findings on this report.",
      "items": {
        "$ref": "#/$defs/FindingKind"
      },
      "title": "Flags",
      "type": "array"
    },
    "grading": {
      "description": "Reliability letter and credibility digit, such as B2.",
      "title": "Grading",
      "type": "string"
    },
    "hazards": {
      "description": "Hazard ids.",
      "items": {
        "type": "string"
      },
      "title": "Hazards",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lane": {
      "title": "Lane",
      "type": "string"
    },
    "lane_name": {
      "title": "Lane Name",
      "type": "string"
    },
    "last_changed": {
      "description": "The latest history entry's date.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Last Changed",
      "type": "string"
    },
    "last_verified": {
      "anyOf": [
        {
          "description": "YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Verified"
    },
    "places": {
      "description": "Place ids.",
      "items": {
        "type": "string"
      },
      "title": "Places",
      "type": "array"
    },
    "reliability": {
      "$ref": "#/$defs/Reliability"
    },
    "report_type": {
      "$ref": "#/$defs/ReportType"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requirement Ids",
      "type": "array"
    },
    "set_ids": {
      "items": {
        "type": "string"
      },
      "title": "Set Ids",
      "type": "array"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/IndicatorState"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "topics": {
      "description": "Topic ids.",
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "grading",
    "reliability",
    "credibility",
    "report_type",
    "state",
    "bucket",
    "directions",
