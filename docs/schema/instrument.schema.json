{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "QueryConfig": {
      "additionalProperties": false,
      "description": "One query in the instrument.",
      "properties": {
        "discipline": {
          "$ref": "#/$defs/Discipline"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "lane": {
          "description": "Where the query looks; feed queries read this lane's feeds.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Lane",
          "type": "string"
        },
        "negative_terms": {
          "description": "Terms that drop a hit, after the global ones.",
          "items": {
            "type": "string"
          },
          "title": "Negative Terms",
          "type": "array"
        },
        "requirement_hints": {
          "description": "Requirement ids the hits may bear on; hints, not tags.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Requirement Hints",
          "type": "array"
        },
        "site_source_ids": {
          "description": "osint_site only: the sources to restrict the query to.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Site Source Ids",
          "type": "array"
        },
        "text": {
          "description": "Query text; site and feed queries OR-join quoted phrases.",
          "title": "Text",
          "type": "string"
        },
        "topic_hints": {
          "description": "Topic ids; hints, not tags.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Topic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "discipline",
        "lane",
        "text"
      ],
      "title": "QueryConfig",
      "type": "object"
    }
  },
  "$id": "instrument.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "config/instrument.json: the versioned query instrument.",
  "properties": {
    "content_hash": {
      "description": "sha256 of the canonical JSON of every field except notes and this one.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "global_negative_terms": {
      "items": {
        "type": "string"
      },
      "title": "Global Negative Terms",
      "type": "array"
    },
    "max_requests_per_run": {
      "description": "The request budget of one scan run.",
      "minimum": 1,
      "title": "Max Requests Per Run",
      "type": "integer"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/QueryConfig"
      },
      "minItems": 1,
      "title": "Queries",
      "type": "array"
    },
    "version": {
      "description": "Such as 2026.10.0.",
      "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "content_hash",
    "max_requests_per_run",
    "queries"
  ],
  "title": "InstrumentFile",
  "type": "object"
}
