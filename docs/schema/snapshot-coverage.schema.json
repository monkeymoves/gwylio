{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "CoverageAxisView": {
      "additionalProperties": false,
      "description": "One taxonomy axis by count.",
      "properties": {
        "axis_id": {
          "title": "Axis Id",
          "type": "string"
        },
        "axis_name": {
          "title": "Axis Name",
          "type": "string"
        },
        "matrix": {
          "$ref": "#/$defs/CoverageMatrixView"
        }
      },
      "required": [
        "axis_id",
        "axis_name",
        "matrix"
      ],
      "title": "CoverageAxisView",
      "type": "object"
    },
    "CoverageCellView": {
      "additionalProperties": false,
      "description": "One cell: a count and what it means.",
      "properties": {
        "column_id": {
          "title": "Column Id",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "column_id",
        "count",
        "status"
      ],
      "title": "CoverageCellView",
      "type": "object"
    },
    "CoverageColumn": {
      "additionalProperties": false,
      "description": "One column of a coverage matrix.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "CoverageColumn",
      "type": "object"
    },
    "CoverageMatrixView": {
      "additionalProperties": false,
      "description": "A coverage matrix: columns, rows and the report ids it counted.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/CoverageColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "report_ids": {
          "items": {
            "type": "string"
          },
          "title": "Report Ids",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CoverageRowView"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows",
        "report_ids"
      ],
      "title": "CoverageMatrixView",
      "type": "object"
    },
    "CoverageRowView": {
      "additionalProperties": false,
      "description": "One row with its total and the row's status.\n\nOn the lane matrix a row is a requirement and its status comes from its\nscanability and total, so a blind spot is never shown as quiet. On a\ntaxonomy matrix a row is a node and ``expected`` counts the requirements\nexpecting it.",
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/CoverageCellView"
          },
          "title": "Cells",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "row_id",
        "label",
        "code",
        "cells",
        "total",
        "status",
        "expected"
      ],
      "title": "CoverageRowView",
      "type": "object"
    },
    "CoverageStatus": {
      "description": "The state of one requirement in the picture.",
      "enum": [
        "covered",
        "thin",
        "quiet",
        "blind_spot"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "Credibility": {
      "description": "The Admiralty credibility of one report's information, 1 (best) to 6 (cannot be judged).\n\nThe analyst judges credibility per report; the source's reliability is\nfixed by the watchlist. The two together make the grading, such as B2.",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Credibility",
      "type": "integer"
    },
    "CredibilityBar": {
      "additionalProperties": false,
      "description": "How many reports carry one credibility digit: one bar of the grade inflation check.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "credibility": {
          "$ref": "#/$defs/Credibility"
        },
        "label": {
          "description": "The Admiralty wording, such as probably true.",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "credibility",
        "label",
        "count"
      ],
      "title": "CredibilityBar",
      "type": "object"
    },
    "LegendEntry": {
      "additionalProperties": false,
      "description": "One coverage status in the legend.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "status",
        "label",
        "meaning"
      ],
      "title": "LegendEntry",
      "type": "object"
    }
  },
  "$id": "snapshot-coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "coverage_<set>.json, GET /api/v1/coverage/{set}: both matrices and the legend.",
  "properties": {
    "credibility": {
      "description": "Active reports assessed against the set, by credibility digit.",
      "items": {
        "$ref": "#/$defs/CredibilityBar"
      },
      "title": "Credibility",
      "type": "array"
    },
    "lanes": {
      "$ref": "#/$defs/CoverageMatrixView",
      "description": "Requirements down, lanes across."
    },
    "legend": {
      "items": {
        "$ref": "#/$defs/LegendEntry"
      },
      "title": "Legend",
      "type": "array"
    },
    "set_id": {
      "title": "Set Id",
      "type": "string"
    },
    "set_name": {
      "title": "Set Name",
      "type": "string"
    },
    "taxonomy": {
      "description": "Taxonomy nodes down, one per axis.",
      "items": {
        "$ref": "#/$defs/CoverageAxisView"
      },
      "title": "Taxonomy",
      "type": "array"
    }
  },
  "required": [
    "set_id",
    "set_name",
    "legend",
    "lanes",
    "taxonomy",
    "credibility"
  ],
  "title": "Coverage",
  "type": "object"
}
