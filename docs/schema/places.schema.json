{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "PlaceConfig": {
      "additionalProperties": false,
      "description": "A named location.",
      "properties": {
        "centroid": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude and longitude in decimal degrees (WGS 84).",
          "title": "Centroid"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PlaceKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The id of the containing place.",
          "title": "Parent"
        },
        "welsh_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Welsh name, where different.",
          "title": "Welsh Name"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "PlaceConfig",
      "type": "object"
    },
    "PlaceKind": {
      "description": "The kind of a named place.",
      "enum": [
        "nation",
        "region",
        "area",
        "river_basin",
        "settlement",
        "site"
      ],
      "title": "PlaceKind",
      "type": "string"
    }
  },
  "$id": "places.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "config/reference/places.json: the place catalogue.",
  "properties": {
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/PlaceConfig"
      },
      "minItems": 1,
      "title": "Places",
      "type": "array"
    }
  },
  "required": [
    "places"
  ],
  "title": "PlacesFile",
  "type": "object"
}
