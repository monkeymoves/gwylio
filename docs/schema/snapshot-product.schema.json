          "title": "End",
          "type": "string"
        },
        "label": {
          "description": "YYYY-MM for a month, YYYY for a year.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Label",
          "type": "string"
        },
        "start": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
