{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "Discipline": {
      "description": "The kind of collection a collector performs.",
      "enum": [
        "osint_web",
        "osint_feed",
        "osint_site",
        "osint_academic",
        "geoint",
        "sensor"
      ],
      "title": "Discipline",
      "type": "string"
    },
    "Lens": {
      "description": "The three viewpoints the commission asked for; every lane sits under one.",
      "enum": [
        "government",
        "partnership_society",
        "international"
      ],
      "title": "Lens",
      "type": "string"
    },
    "Reliability": {
      "description": "The Admiralty reliability of a source, A (best) to F (cannot be judged).\n\nReliability belongs to the source, never to one report: the analyst judges\ncredibility (1 to 6) per report, and the two together make the grading.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ],
      "title": "Reliability",
      "type": "string"
    },
    "SourceStatus": {
      "description": "Whether a source is watched.",
      "enum": [
        "active",
        "parked",
        "retired"
      ],
      "title": "SourceStatus",
      "type": "string"
    },
    "YieldReading": {
      "description": "What a source's yield says about its place on the watchlist.",
      "enum": [
        "earning_its_place",
        "high_volume_no_promotions",
        "low_volume",
        "silent"
      ],
      "title": "YieldReading",
      "type": "string"
    }
  },
  "$id": "snapshot-source-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entry of sources.json, GET /api/v1/sources: the watchlist entry and its yield.",
  "properties": {
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "actor_name": {
      "title": "Actor Name",
      "type": "string"
    },
    "added_on": {
      "description": "YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Added On",
      "type": "string"
    },
    "discipline": {
      "$ref": "#/$defs/Discipline"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "feed_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Feed Url"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lane": {
      "title": "Lane",
      "type": "string"
    },
    "lane_name": {
      "title": "Lane Name",
      "type": "string"
    },
    "last_productive_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Productive Run"
    },
    "last_run_with_hits": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Run With Hits"
    },
    "lens": {
      "$ref": "#/$defs/Lens"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notes"
    },
    "promoted": {
      "title": "Promoted",
      "type": "integer"
    },
    "promotion_rate": {
      "anyOf": [
        {
          "description": "A share from 0 to 1, rounded to four places.",
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Promoted over unique candidates.",
      "title": "Promotion Rate"
    },
    "raw_hits": {
      "description": "Stored sightings: hits that passed the gates.",
      "title": "Raw Hits",
      "type": "integer"
    },
    "reading": {
      "$ref": "#/$defs/YieldReading"
    },
    "reliability": {
      "$ref": "#/$defs/Reliability"
    },
    "reliability_label": {
      "title": "Reliability Label",
      "type": "string"
    },
    "site_pass": {
      "title": "Site Pass",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/SourceStatus"
    },
    "trusted": {
      "title": "Trusted",
      "type": "boolean"
    },
    "unique_candidates": {
      "title": "Unique Candidates",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "domain",
    "feed_url",
    "discipline",
    "lane",
    "lane_name",
    "lens",
    "actor",
    "actor_name",
    "reliability",
    "reliability_label",
    "trusted",
    "site_pass",
    "status",
    "added_on",
    "notes",
    "raw_hits",
    "unique_candidates",
    "promoted",
    "promotion_rate",
    "last_run_with_hits",
    "last_productive_run",
    "reading"
  ],
  "title": "SourceSummary",
  "type": "object"
}
