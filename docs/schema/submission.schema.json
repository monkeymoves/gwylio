{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "AssessmentEntry": {
      "additionalProperties": false,
      "description": "Which way the report bears on one requirement.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "requirement_id": {
          "description": "A requirement id from skill/REFERENCE.md, such as si4.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "direction"
      ],
      "title": "AssessmentEntry",
      "type": "object"
    },
    "Bucket": {
      "description": "Where a report goes next.",
      "enum": [
        "brief",
        "follow_up",
        "watch",
        "park"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "Credibility": {
      "description": "The Admiralty credibility of one report's information, 1 (best) to 6 (cannot be judged).\n\nThe analyst judges credibility per report; the source's reliability is\nfixed by the watchlist. The two together make the grading, such as B2.",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Credibility",
      "type": "integer"
    },
    "Direction": {
      "description": "Which way a report bears on one requirement.",
      "enum": [
        "supports",
        "threatens",
        "neutral",
        "informs_baseline"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DispositionEntry": {
      "additionalProperties": false,
      "description": "The fate of one candidate.",
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/DispositionOutcome"
        },
        "reason": {
          "description": "One sentence: which part of the promotion test decided.",
          "title": "Reason",
          "type": "string"
        },
        "report_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "promoted: the new report; reinforcement: the report it reinforces; duplicate: optionally, the report it duplicates.",
          "title": "Report Id"
        }
      },
      "required": [
        "candidate_id",
        "outcome",
        "reason"
      ],
      "title": "DispositionEntry",
      "type": "object"
    },
    "DispositionOutcome": {
      "description": "The fate the analyst gives one candidate in a submission.",
      "enum": [
        "promoted",
        "rejected",
        "duplicate",
        "deferred",
        "reinforcement"
      ],
      "title": "DispositionOutcome",
      "type": "string"
    },
    "Level": {
      "description": "A three-point score: low, medium or high.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Level",
      "type": "string"
    },
    "PriorHistoryEntry": {
      "additionalProperties": false,
      "description": "One line of history the report had before it entered Gwylio (the legacy import).",
      "properties": {
        "change": {
          "title": "Change",
          "type": "string"
        },
        "on": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "On",
          "type": "string"
        }
      },
      "required": [
        "on",
        "change"
      ],
      "title": "PriorHistoryEntry",
      "type": "object"
    },
    "PromotionEntry": {
      "additionalProperties": false,
      "description": "A new intelligence report. Reliability, lane and appearances are not the analyst's.",
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The actor, when catalogued.",
          "title": "Actor Id"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/AssessmentEntry"
          },
          "minItems": 1,
          "title": "Assessments",
          "type": "array"
        },
        "bucket": {
          "$ref": "#/$defs/Bucket"
        },
        "creation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text of the creation history entry, if not the default.",
          "title": "Creation Note"
        },
        "credibility": {
          "$ref": "#/$defs/Credibility",
          "description": "Admiralty credibility, 1 to 6."
        },
        "event_horizon": {
          "anyOf": [
            {
              "description": "A date, YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Horizon"
        },
        "from_candidate": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The candidate this report was promoted from, if any.",
          "title": "From Candidate"
        },
        "hazards": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Hazards",
          "type": "array"
        },
        "id": {
          "description": "A new kebab-case report id.",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "lane": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it was found; required when source_id is null, else the source's.",
          "title": "Lane"
        },
        "last_verified": {
          "anyOf": [
            {
              "description": "A date, YYYY-MM-DD.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "places": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "prior_history": {
          "description": "History from before Gwylio, carried as imported entries (legacy import).",
          "items": {
            "$ref": "#/$defs/PriorHistoryEntry"
          },
          "title": "Prior History",
          "type": "array"
        },
        "reliability_if_unknown_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reliability"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when source_id is null; ignored otherwise (the source decides)."
        },
        "report_type": {
          "$ref": "#/$defs/ReportType"
        },
        "scores": {
          "$ref": "#/$defs/ScoresEntry"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The watched source, or null when unwatched.",
          "title": "Source Id"
        },
        "source_name": {
          "description": "Who published it, as a reader would name them.",
          "title": "Source Name",
          "type": "string"
        },
        "state_override": {
          "anyOf": [
            {
              "enum": [
                "matured",
                "parked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Create the report as matured or parked instead of emerging.",
          "title": "State Override"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "topics": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "url": {
          "description": "The http or https URL.",
          "minLength": 1,
          "pattern": "^https?://[^\\s]+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "source_id",
        "source_name",
        "report_type",
        "credibility",
        "assessments",
        "scores",
        "bucket",
        "summary"
      ],
      "title": "PromotionEntry",
      "type": "object"
    },
    "ReinforcementLink": {
      "additionalProperties": false,
      "description": "A candidate whose sightings count for an existing report.",
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "report_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "candidate_id"
      ],
      "title": "ReinforcementLink",
      "type": "object"
    },
    "Reliability": {
      "description": "The Admiralty reliability of a source, A (best) to F (cannot be judged).\n\nReliability belongs to the source, never to one report: the analyst judges\ncredibility (1 to 6) per report, and the two together make the grading.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ],
      "title": "Reliability",
      "type": "string"
    },
    "ReportType": {
      "description": "What kind of development an intelligence report describes.",
      "enum": [
        "policy",
        "legislation",
        "research",
        "data_release",
        "funding",
        "partnership",
        "international",
        "legal",
        "environmental",
        "market",
        "incident"
      ],
      "title": "ReportType",
      "type": "string"
    },
    "ScoresEntry": {
      "additionalProperties": false,
      "description": "The analyst's scores for a report.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Level"
        },
        "evidence": {
          "$ref": "#/$defs/Level",
          "description": "How strong the evidence on the page is."
        },
        "novelty": {
          "$ref": "#/$defs/Level"
        },
        "potential_impact": {
          "$ref": "#/$defs/Level"
        },
        "time_horizon": {
          "$ref": "#/$defs/TimeHorizon"
        }
      },
      "required": [
        "evidence",
        "novelty",
        "confidence",
        "potential_impact",
        "time_horizon"
      ],
      "title": "ScoresEntry",
      "type": "object"
    },
    "TimeHorizon": {
      "description": "When a report's consequences are expected to land.",
      "enum": [
        "immediate",
        "near_term",
        "medium_term",
        "long_term"
      ],
      "title": "TimeHorizon",
      "type": "string"
    },
    "UpdateEntry": {
      "additionalProperties": false,
      "description": "Analyst changes to an existing report.",
      "properties": {
        "change": {
          "description": "Why: the history entry text.",
          "title": "Change",
          "type": "string"
        },
        "report_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Report Id",
          "type": "string"
        },
        "set": {
          "additionalProperties": true,
          "description": "Only state (matured or parked), bucket, owner, notes, summary, title, event_horizon and independent_confirmation (true) may be set.",
          "minProperties": 1,
          "title": "Set",
          "type": "object"
        }
      },
      "required": [
        "report_id",
        "set",
        "change"
      ],
      "title": "UpdateEntry",
      "type": "object"
    },
    "VerificationEntry": {
      "additionalProperties": false,
      "description": "The analyst checked the report's claims against the world.",
      "properties": {
        "note": {
          "title": "Note",
          "type": "string"
        },
        "report_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Report Id",
          "type": "string"
        },
        "verified_on": {
          "description": "A date, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Verified On",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "verified_on",
        "note"
      ],
      "title": "VerificationEntry",
      "type": "object"
    }
  },
  "$id": "submission.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "data/submissions/<run_id>__<n>.json: the analyst's judgements on one run, or none.",
  "properties": {
    "analyst": {
      "title": "Analyst",
      "type": "string"
    },
    "dispositions": {
      "items": {
        "$ref": "#/$defs/DispositionEntry"
      },
      "title": "Dispositions",
      "type": "array"
    },
    "method_note": {
      "description": "How the run was judged: what was read and skipped.",
      "title": "Method Note",
      "type": "string"
    },
    "promotions": {
      "items": {
        "$ref": "#/$defs/PromotionEntry"
      },
      "title": "Promotions",
      "type": "array"
    },
    "received_on": {
      "description": "A date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "title": "Received On",
      "type": "string"
    },
    "reinforcements": {
      "items": {
        "$ref": "#/$defs/ReinforcementLink"
      },
      "title": "Reinforcements",
      "type": "array"
    },
    "rubric_version": {
      "description": "Such as 2026.10.",
      "pattern": "^[0-9]{4}\\.[0-9]{1,2}$",
      "title": "Rubric Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "description": "A scan run id.",
          "pattern": "^[0-9]{8}T[0-9]{4}Z-[0-9a-f]{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The run judged, or null for out-of-run.",
      "title": "Run Id"
    },
    "schema": {
      "const": "gwylio.submission/1",
      "description": "Always gwylio.submission/1.",
      "title": "Schema",
      "type": "string"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/UpdateEntry"
      },
      "title": "Updates",
      "type": "array"
    },
    "verifications": {
      "items": {
        "$ref": "#/$defs/VerificationEntry"
      },
      "title": "Verifications",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "run_id",
    "analyst",
    "rubric_version",
    "received_on",
    "method_note"
  ],
  "title": "Submission",
  "type": "object"
}
