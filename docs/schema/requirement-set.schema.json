{
  "$comment": "Generated by `gwylio schema` from the Pydantic models registered in backend/src/gwylio/infrastructure/config/schemas.py. Do not edit by hand.",
  "$defs": {
    "GroupKind": {
      "description": "What a requirement group stands for.",
      "enum": [
        "impact",
        "wbo"
      ],
      "title": "GroupKind",
      "type": "string"
    },
    "RequirementConfig": {
      "additionalProperties": false,
      "description": "One Priority Intelligence Requirement (PIR).",
      "properties": {
        "code": {
          "description": "Display code, e.g. SI1.",
          "pattern": "^[A-Z][A-Z0-9]{0,15}$",
          "title": "Code",
          "type": "string"
        },
        "development": {
          "default": false,
          "description": "True while the indicator is still being developed.",
          "title": "Development",
          "type": "boolean"
        },
        "expected_coverage": {
          "description": "Taxonomy node ids this requirement should touch.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Expected Coverage",
          "type": "array"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "metric_sources": {
          "items": {
            "type": "string"
          },
          "title": "Metric Sources",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scanability": {
          "$ref": "#/$defs/Scanability"
        },
        "scanability_note": {
          "title": "Scanability Note",
          "type": "string"
        },
        "short": {
          "description": "At most six words, for tiles and tables.",
          "title": "Short",
          "type": "string"
        }
      },
      "required": [
        "code",
        "id",
        "name",
        "short",
        "scanability",
        "scanability_note"
      ],
      "title": "RequirementConfig",
      "type": "object"
    },
    "RequirementGroupConfig": {
      "additionalProperties": false,
      "description": "An impact statement or a well-being objective grouping requirements.",
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "members": {
          "description": "Requirement ids in this group.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "related_groups": {
          "description": "Ids of other groups in the set this one maps to.",
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Related Groups",
          "type": "array"
        },
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "members"
      ],
      "title": "RequirementGroupConfig",
      "type": "object"
    },
    "Scanability": {
      "description": "How far public, indexed sources can see a requirement at all.",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "title": "Scanability",
      "type": "string"
    }
  },
  "$id": "requirement-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "config/requirement_sets/<id>.json: one requirement set.",
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/$defs/RequirementGroupConfig"
      },
      "title": "Groups",
      "type": "array"
    },
    "id": {
      "description": "Must equal the file name without .json.",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementConfig"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "source_doc": {
      "title": "Source Doc",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "source_doc",
    "requirements"
  ],
  "title": "RequirementSetFile",
  "type": "object"
}
